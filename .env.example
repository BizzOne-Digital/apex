NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/apex_fitness

# Installation + entitlement signing (generate strong secrets for production)
INSTALLATION_TOKEN_SECRET=change-me-installation-secret-min-32-chars
PLAYBACK_URL_SECRET=change-me-playback-secret-min-32-chars
PLAYBACK_URL_TTL_SECONDS=300

# Admin import API (content management)
ADMIN_API_KEY=change-me-admin-key

# Dev-only purchase simulator — MUST be false on Vercel production
ENABLE_DEV_PURCHASE_SIMULATOR=true

# Client preview APK: demo unlock without Google Play (set true on Vercel + preview app build)
CLIENT_PREVIEW_DEMO_PURCHASES=false

# Apple App Store (production verification)
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.apex.fitness

# Google Play (production verification)
GOOGLE_PLAY_PACKAGE_NAME=com.apex.fitness
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=

# Optional: durable media base URL (S3/CDN) after Dropbox ingestion
MEDIA_CDN_BASE_URL=

# Website purchase integration (disabled until client approves)
WEB_PURCHASE_ENABLED=false

# Comma-separated browser origins allowed by CORS (native app does not need this)
CORS_ORIGINS=

# Dedicated secret for user login tokens (32+ random chars). REQUIRED in production.
AUTH_TOKEN_SECRET=

# --- Stripe payments (leave STRIPE_SECRET_KEY empty to keep the in-app store / demo flow) ---
# sk_test_... for development, sk_live_... ONLY in production (the server refuses a live key anywhere else).
# Set these in the hosting dashboard (e.g. Vercel Environment Variables); never commit them or put them in the app.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint: https://<your-api>/api/v1/stripe/webhook  (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Public https URL of this API (used for the page Stripe returns the customer to)
PUBLIC_API_URL=
# Sales tax added on top of each program price
TAX_RATE_PERCENT=8.75
TAX_LABEL=Sales Tax
# Bearer secret for the scheduled reconcile job (Vercel Cron). Optional; the route is off when empty.
CRON_SECRET=

# --- Database sharding of accounts (see scripts/enable-sharding.ts) ---
# true only AFTER the users collection has been sharded
USERS_SHARDED=false
# set false once scripts/backfill-user-emails.ts has run
USER_LEGACY_EMAIL_LOOKUP=true

# --- Purchase confirmation emails (customer + owner). Leave SMTP_HOST empty to turn emails off. ---
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the mailbox, SMTP_PASS=an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OWNER_NOTIFY_EMAIL=
