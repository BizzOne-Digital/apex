{
  "name": "apex-fitness-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "shard:users": "tsx scripts/enable-sharding.ts",
    "backfill:user-emails": "tsx scripts/backfill-user-emails.ts",
    "import:content": "tsx scripts/import-content.ts",
    "sync:videos": "tsx scripts/sync-client-videos.ts",
    "sync:elite-videos": "tsx scripts/sync-elite-videos.ts",
    "sync:platinum-videos": "tsx scripts/sync-platinum-videos.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.3",
    "nodemailer": "^10.3.1",
    "serverless-http": "^3.2.0",
    "stripe": "^23.1.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  }
}
